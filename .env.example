# Copy to .env (local) or set in Vercel project settings (deployed).
# The browser never sees these; only the /api/extract server function reads them.

# Meta Model API key for Muse Ember. Get it from your Meta Model API account.
# Until this is set, /api/extract falls back to the mock adapter and says so.
MODEL_API_KEY=

# Ember model + endpoint (defaults match the public Meta Model API docs).
EMBER_MODEL=muse-ember-1.0
EMBER_API_BASE=https://api.meta.ai/v1

# Per-token pricing used by the cost meter, in USD per 1M tokens.
# Official rates for muse-ember-1.0 (<200K context), from the Meta Model
# API pricing table linked from the hackathon participant guide,
# confirmed 2026-11-24: $0.10 input / $0.50 output per 1M tokens.
EMBER_INPUT_RATE_PER_MTOK=0.10
EMBER_OUTPUT_RATE_PER_MTOK=0.50
